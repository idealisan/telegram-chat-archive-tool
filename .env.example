# Copy this file to '.env' and fill in your credentials
# (obtain API_ID / API_HASH from https://my.telegram.org).
# '.env' is git-ignored — never commit it.
# Real environment variables take precedence over this file.

# --- Required ---
API_ID=
API_HASH=

# --- Paths ---
SESSION_NAME=tg_session
MEDIA_DIR=./media
DB_PATH=./messages.db

# --- Behaviour ---
MIN_FREE_SPACE_GB=10
DOWNLOAD_MEDIA=true
# Comma-separated subset of: photo, video, video_note, document, audio, voice, sticker, animation
MEDIA_TYPES=photo,video,video_note,document,audio,voice,sticker,animation
# Skip media larger than this (MB). Empty = no limit.
MAX_FILE_SIZE_MB=
# Fetch/save messages referenced by Telegram message links in text or captions (one hop).
RESOLVE_TME_LINKS=true
REQUEST_DELAY_SECONDS=0.5
# SOCKS5/HTTP proxy URL, e.g. socks5://127.0.0.1:1080 . Empty = no proxy.
PROXY=
# Extra directories (comma-separated) searched before re-downloading existing media.
SEARCH_PATHS=
# If true, don't re-download files whose DB record exists but file is missing from disk.
SKIP_MISSING_MEDIA=false
# When resolving a linked album item, scan this many message IDs before/after it.
GROUP_SCAN_WINDOW=12
# Dump every loaded dialog (numbered, one per line) at startup for diagnosis.
# true = ./dialogs_debug.txt, or give a custom path. Empty = off.
# DEBUG_DIALOGS_FILE=
